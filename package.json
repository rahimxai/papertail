{
  "name": "papertrail",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:dev": "prisma dev --name papertrail --detach",
    "db:test": "prisma dev --name papertrail-test --detach",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "audit:api": "node scripts/api-audit.mjs",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && prisma migrate deploy && prisma db seed && next build"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tiptap/core": "^3.34.0",
    "@tiptap/extensions": "^3.34.0",
    "@tiptap/html": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "happy-dom": "^21.0.4",
    "lucide-react": "^1.76.0",
    "mammoth": "^1.13.0",
    "marked": "^18.2.1",
    "next": "16.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jszip": "^3.10.2",
    "prisma": "^7.10.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "prosemirror-schema-list": "1.6.0",
    "prosemirror-inputrules": "1.6.0"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true
  }
}
