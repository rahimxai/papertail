# Copy to .env and fill in. `.env` is git-ignored.

# --- Local development -------------------------------------------------------
# `npm run db:dev` starts a local Postgres (Prisma dev / PGlite) and prints its URLs.
# Paste the TCP connection string ("postgres://postgres:postgres@localhost:<port>/template1?sslmode=disable").
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
# Only needed by `prisma migrate dev` when changing the schema (the shadow URL printed by `prisma dev`).
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"
# Separate database for `npm test`; the suite wipes it before every test. `npm run db:test` prints this URL.
TEST_DATABASE_URL="postgres://postgres:postgres@localhost:51218/template1?sslmode=disable"
# PGlite serves one connection at a time, so keep the pool at 1 locally. Leave unset in production (defaults to 5).
DATABASE_POOL_MAX=1

# --- Production (Vercel + Neon) ----------------------------------------------
# Injected automatically by the Neon integration; do not set by hand on Vercel.
# DATABASE_URL           = pooled connection string, used by the app at runtime
# DATABASE_URL_UNPOOLED  = direct connection string, used by `prisma migrate deploy` and the seed
